# Copy to .env.local (git-ignored) and fill in. Only needed for live builds; simulated
# builds work without any of this.

# Postgres. The default matches `npm run db:local` and docker-compose.yml.
# DATABASE_URL=postgres://postgres:makabl@127.0.0.1:5433/makabl

# Your Claude API key (console.anthropic.com). Live builds spend real money on it.
ANTHROPIC_API_KEY=

# Live builds run model-written code (npm install, tests, next build) on this computer
# without a sandbox. Set to 1 only if you accept that.
MAKABL_ALLOW_UNSANDBOXED_BUILDS=0
