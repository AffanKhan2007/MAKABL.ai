# Copy to .env.local (git-ignored) and fill in. Real builds need one provider key.

# Postgres. The default matches `npm run db:local` and docker-compose.yml.
# DATABASE_URL=postgres://postgres:makabl@127.0.0.1:5433/makabl

# Gemini API key (a free tier is available; free-tier prompts may be used to improve
# Google's products). Restrict the key to Gemini API in Google AI Studio.
GEMINI_API_KEY=

# Optional Claude API key (console.anthropic.com).
ANTHROPIC_API_KEY=

# Optional, for relay phases on OpenAI models: an OpenAI key, or an OpenRouter key
# (one key, OpenAI models at list price plus a 5.5% fee when buying credits). If both
# are set, OpenAI is called directly.
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Optional free-tier providers for relay phases (each has a daily request limit).
# Groq: console.groq.com/keys. Mistral: console.mistral.ai, "Experiment" (free) plan.
# OPENROUTER_API_KEY above also unlocks OpenRouter's ":free" models.
GROQ_API_KEY=
MISTRAL_API_KEY=

# Optional, for Qwen models: a Qwen Cloud (Alibaba Model Studio) key from the Singapore
# region. New accounts get a free token allowance per model; turn on "free quota only" in
# the console so nothing is billed when it runs out.
DASHSCOPE_API_KEY=

# Live builds run model-written code (npm install, tests, next build) on this computer
# without a sandbox. Set to 1 only if you accept that.
MAKABL_ALLOW_UNSANDBOXED_BUILDS=0

